# === Runtime de la app (validado por src/lib/env.ts al arranque) ===
# Fase 0: Postgres local/efímero basta. En Railway (Fase 12) es la referencia
# ${{Postgres.DATABASE_URL}} del environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sci"

# better-auth (Fase 2, ADR-004). Genera el secret con: openssl rand -base64 32
# (distinto por environment). BETTER_AUTH_URL = dominio público del environment
# en Railway (p.ej. https://sci-develop.up.railway.app); en local, el de dev.
BETTER_AUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# === Solo scripts (no runtime de la app) ===
# Migrador de datos (pnpm migrate:data, scripts/migracion/firebase.ts): config web
# pública de Firebase para leer los 3 docs del monolito vía SDK + login anónimo.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# Seed de credenciales (pnpm seed:auth, scripts/seed/auth.ts): password inicial
# provisionada a los usuarios migrados; cada uno la cambia en /cambiar-password.
SEED_PASSWORD=""
